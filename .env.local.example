# Copy to .env.local and fill in. NEVER commit .env.local (it's gitignored).

# --- Postgres ---
# Local dev (Docker): postgres://postgres:dev@localhost:5432/dsa_guardian
# Vercel Postgres / Neon: copy the "postgres://..." connection string from the dashboard.
DATABASE_URL=postgres://postgres:dev@localhost:5432/dsa_guardian
# Set to "disable" to turn off SSL (local Postgres). Leave unset in production.
PGSSL=disable

# --- NextAuth v5 (GitHub OAuth) ---
# Generate: openssl rand -base64 32
AUTH_SECRET=
# When served behind a proxy / rewrite (e.g. portfolio → /dsaguardian),
# NextAuth must know the public-facing ORIGIN so it builds correct redirect URLs.
# Set this to the ORIGIN ONLY (no path). The "/dsaguardian/api/auth" prefix is
# configured as `basePath` in lib/auth.ts — do NOT also put it here, or Auth.js
# logs an "env-url-basepath-mismatch" warning.
#   Production: https://adityashrotriya.me
#   Local dev:  http://localhost:3001
AUTH_URL=http://localhost:3001
# Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:           https://adityashrotriya.me/dsaguardian
#   Authorization callback: https://adityashrotriya.me/dsaguardian/api/auth/callback/github
# (In local dev: http://localhost:3001/dsaguardian/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Secret encryption (LEETCODE_SESSION cookie at rest) ---
# Generate: openssl rand -base64 32  (must decode to exactly 32 bytes)
ENCRYPTION_KEY=
